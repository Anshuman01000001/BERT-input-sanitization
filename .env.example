# Copy to .env and fill in the two secrets. Both are required: the compose
# file refuses to start without them, and the service refuses to start on the
# well-known development key.
#
# Generate them with:  openssl rand -hex 32

# --- service ---------------------------------------------------------------
# Required, at least 16 characters.
MOD_API_KEY=
# Required. Used for the Redis password and embedded in MOD_REDIS_URL.
MOD_REDIS_PASSWORD=

# For local development only. Without this the service refuses to start on
# the default development key, because that key is public in this repository.
MOD_ALLOW_INSECURE_DEFAULT_KEY=false

MOD_REQUIRE_API_KEY=true
MOD_LOG_LEVEL=INFO
MOD_ENABLE_DEMO=true
# Whether the raw message text is written to the decision log.
MOD_LOG_MESSAGE_TEXT=true

# --- model -----------------------------------------------------------------
# Threads per worker. Keep workers * threads below the core count.
MOD_ONNX_THREADS=2
MOD_MAX_SEQ_LEN=128

# --- toxicity thresholds ---------------------------------------------------
# Hard categories (threat, identity_hate, severe_toxic) block at this score.
MOD_BLOCK_THRESHOLD=0.70
# Soft categories (toxic, insult, obscene) are only flagged at this score.
MOD_FLAG_THRESHOLD=0.90
MOD_HARD_LABELS=threat,identity_hate,severe_toxic
MOD_SOFT_LABELS=toxic,insult,obscene

# --- spam ------------------------------------------------------------------
MOD_RATE_LIMIT_COUNT=5
MOD_RATE_LIMIT_WINDOW_S=10
MOD_NEW_ACCOUNT_RATE_LIMIT=3
MOD_NEW_ACCOUNT_AGE_S=3600

# --- behaviour score -------------------------------------------------------
MOD_SCORE_DECAY_INTERVAL_S=3600
MOD_SCORE_DECAY_POINTS=1
MOD_SCORE_WARN_AT=5
MOD_SCORE_FLAG_AT=15
MOD_SCORE_MUTE_AT=30
MOD_SCORE_BAN_REVIEW_AT=60
MOD_MUTE_DURATIONS_S=600,3600,86400

# --- reports ---------------------------------------------------------------
# A report only counts when the target's own messages corroborate it.
MOD_REPORT_POINTS=10
MOD_REPORT_POINTS_CAP=10
MOD_REPORT_POINTS_WINDOW_S=3600
MOD_REPORTER_TRUST_FULL_COUNT=3
MOD_REPORTER_TRUST_HALF_COUNT=10

# --- API rate limiting -----------------------------------------------------
MOD_API_RATE_LIMIT_COUNT=200
MOD_API_RATE_LIMIT_GLOBAL_COUNT=1000
MOD_API_RATE_LIMIT_WINDOW_S=1

# --- behaviour -------------------------------------------------------------
# When a cheap check already decided the outcome, skip the classifier.
MOD_SKIP_MODEL_ON_SPAM=true

# --- compose ---------------------------------------------------------------
# Used by docker-compose.yml for the published port.
MOD_PORT=8000
